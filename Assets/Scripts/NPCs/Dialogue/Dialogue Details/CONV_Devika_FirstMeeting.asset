  conversationID: "devika_first_meeting"
  conversationName: "Devika \u2014 First Meeting"
  description: "Devika tests Howe's usefulness and either offers him Ledger House access or becomes cautious of him."
  startNodeID: "start"
  nodes:
  - nodeID: "start"
    speaker: {fileID: 11400000, guid: 0c1fdf729adb743008299b21f944029f, type: 2}
    line: "You are early. That is either discipline or fear. In this city, both are useful."
    lineType: 0
    nextNodeID: "player_response"
    choices: []
    conditions: []
    onEnterEffects: []
    onExitEffects: []
