  - nodeID: "offer_job"
    speaker: {fileID: 11400000, guid: 0c1fdf729adb743008299b21f944029f, type: 2}
    line: "Ledger House needs a clerk. Not a clever one. A quiet one."
    lineType: 0
    nextNodeID: "offer_job_confirm"
    choices: []
    conditions: []
    onEnterEffects:
    - effectType: 1
