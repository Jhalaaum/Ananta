  - nodeID: "cautious_reply"
    speaker: {fileID: 11400000, guid: 0c1fdf729adb743008299b21f944029f, type: 2}
    line: "Rules are just traps with better names. Learn where they are, or bleed on them."
    lineType: 0
    nextNodeID: "cautious_choice"
    choices: []
    conditions: []
    onEnterEffects: []
    onExitEffects: []
