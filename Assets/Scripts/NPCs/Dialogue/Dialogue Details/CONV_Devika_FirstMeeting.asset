  - nodeID: "player_response"
    speaker: {fileID: 11400000, guid: c13edcd8710b54bde84a52fe9ccbdd7f, type: 2}
    line: "I was told useful men survive longer here."
    lineType: 0
    nextNodeID: ""
    choices:
    - responseText: "Then make yourself useful."
      nextNodeID: "offer_job"
      conditions: []
      effects:
