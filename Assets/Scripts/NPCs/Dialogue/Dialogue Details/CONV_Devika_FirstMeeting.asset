  - nodeID: "offer_job_confirm"
    speaker: {fileID: 11400000, guid: c13edcd8710b54bde84a52fe9ccbdd7f, type: 2}
    line: "Quiet I can do. Cleverness I will keep unpaid."
    lineType: 0
    nextNodeID: "devika_final_instruction"
    choices: []
    conditions: []
    onEnterEffects: []
    onExitEffects: []
    autoContinue: 0
    autoContinueDelay: 1.5
  - nodeID: "devika_final_instruction"
    speaker: {fileID: 11400000, guid: 0c1fdf729adb743008299b21f944029f, type: 2}
    line: "Good. Report to Ledger House before the second bell. If anyone asks, you were recommended because you count faster than you speak."
    lineType: 0
    nextNodeID: ""
    choices: []
    conditions: []
    onEnterEffects:
    - effectType: 5
